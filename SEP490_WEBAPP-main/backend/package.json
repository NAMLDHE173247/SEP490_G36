{
  "name": "chatbot-converter-backend",
  "version": "1.0.0",
  "description": "Backend API for chatbot data conversion",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze:rp5": "tsx src/scripts/analyze_rp5.ts",
    "test:rp5": "tsx src/scripts/analyze_rp5.ts --self-test",
    "test:human-audit": "tsx src/scripts/testHumanAudit.ts",
    "test:human-audit-workflow": "tsx src/scripts/testHumanAuditWorkflow.ts",
    "test:rbac": "tsx src/scripts/testRbacWorkflow.ts"
  },
  "keywords": [
    "chatbot",
    "finetuning",
    "converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "minio": "^8.0.7",
    "axios": "^1.13.6",
    "dotenv": "^16.6.1",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "express": "^4.18.2",
    "mongoose": "^9.2.4",
    "form-data": "^4.0.5",
    "node-fetch": "^3.3.2",
    "compression": "^1.7.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "@types/adm-zip": "^0.5.8",
    "@huggingface/hub": "^2.10.5",
    "express-rate-limit": "^7.5.1",
    "@azure/storage-blob": "^12.32.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^2.1.9",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.42",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/parser": "^6.17.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0"
  }
}
