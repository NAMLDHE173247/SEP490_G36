PORT=3000
MONGODB_URI=mongodb://localhost:27017/sep490

# BẮT BUỘC — không có fallback. Backend sẽ từ chối khởi động nếu thiếu.
JWT_SECRET=change_me_to_a_long_random_secret
ENCRYPTION_KEY=change_me_to_a_separate_random_secret

# CORS allowlist (phân tách bằng dấu phẩy)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared secret gửi tới GPU service (phải khớp GPU_SERVICE_TOKEN của GPU service)
GPU_SERVICE_TOKEN=change_me_shared_gpu_secret

# ── Object storage (MinIO / S3) ───────────────────────────────────────────────
# Một client S3 duy nhất, đổi endpoint theo môi trường (giống LLMAware):
#   Local/dev : endpoint = localhost:9000 (hoặc minio:9000 trong Docker), SECURE=false
#   Production: endpoint = cdn-lab.fpt.edu.vn, SECURE=true, PUBLIC_URL=https://cdn-lab.fpt.edu.vn
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=llm_trains
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Để trống ở dev; production đặt = https://cdn-lab.fpt.edu.vn để build URL công khai
STORAGE_PUBLIC_URL=
# true khi endpoint chạy HTTPS (bắt buộc cho CDN production để tránh 301 mất S3 auth)
STORAGE_SECURE=false
# Bật/tắt lưu qua object storage. false → giữ hành vi lưu đĩa cũ (backward-compatible)
STORAGE_ENABLED=true

# Optional transactional email via Resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=SEP490 <noreply@your-domain.com>
