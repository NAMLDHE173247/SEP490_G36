# ============================================================
# SEP490 WEBAPP — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực:
#   cp .env.example .env
#   nano .env
# ============================================================

# ── GPU Service ──────────────────────────────────────────────
# Anthropic API Key (dùng cho Claude LLM Judge trong eval)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace Token (để push/pull model từ HF Hub)
HF_TOKEN=your_huggingface_token_here

# ── Backend General ──────────────────────────────────────────
# Server Port
PORT=3000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/sep_training

# JWT Secret Key for token generation (BẮT BUỘC — đổi thành chuỗi ngẫu nhiên dài)
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# Khóa mã hóa API key lưu trong DB (BẮT BUỘC, tách biệt khỏi JWT_SECRET)
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_a_separate_random_secret

# Danh sách origin frontend được phép gọi API (CORS), phân tách bằng dấu phẩy
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared secret giữa backend và GPU service. BẮT BUỘC set ở mọi deployment công khai.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GPU_SERVICE_TOKEN=change_me_shared_gpu_secret

# Cho phép seed tài khoản demo (mật khẩu "1"). KHÔNG bật ở production.
ALLOW_DEMO_SEED=false

# Cho phép màn hình OAuth giả lập (đăng nhập bằng email bất kỳ). KHÔNG bật ở production.
ALLOW_MOCK_OAUTH=false

# GPU Service URL (chạy local ngoài docker)
GPU_SERVICE_URL=http://localhost:5000

# ── Backend LLM Providers ────────────────────────────────────
# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API (mặc định dùng Groq)
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Google Drive Integration ─────────────────────────────────
# Google Drive (JSON service account, 1 dòng)
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ── OAuth Configuration (Google & Microsoft Outlook) ────────
# LƯU Ý BẢO MẬT: KHÔNG commit secret thật vào repo. Dùng placeholder ở đây và
# đặt giá trị thật trong .env (đã gitignore). Nếu secret cũ từng bị commit,
# hãy xoay (rotate) lại ngay trên Google/Azure console.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

OUTLOOK_CLIENT_ID=your_outlook_client_id_here
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret_here

# ── Redirect Configuration (Port 8080) ───────────────────────
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
OUTLOOK_REDIRECT_URI=http://localhost:8080/api/auth/outlook/callback
FRONTEND_URL=http://localhost:8080
