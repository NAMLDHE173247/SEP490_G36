# ============================================================
# SEP490 WEBAPP — Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực:
#   cp .env.example .env
#   nano .env
# ============================================================

# ── GPU Service ──────────────────────────────────────────────
# Anthropic API Key (dùng cho Claude LLM Judge trong eval)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace Token (để push/pull model từ HF Hub)
HF_TOKEN=your_huggingface_token_here

# ── Backend General ──────────────────────────────────────────
# Server Port
PORT=3000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/sep_training

# JWT Secret Key for token generation
JWT_SECRET=super_secret_session_jwt_key_please_change_this_in_production

# GPU Service URL (chạy local ngoài docker)
GPU_SERVICE_URL=http://localhost:5000

# ── Backend LLM Providers ────────────────────────────────────
# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API (mặc định dùng Groq)
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Google Drive Integration ─────────────────────────────────
# Google Drive (JSON service account, 1 dòng)
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ── OAuth Configuration (Google & Microsoft Outlook) ────────
GOOGLE_CLIENT_ID=532813664770-l2n2ipsiigon66dn0ps079j2u4fdrobn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

OUTLOOK_CLIENT_ID=26fb54d6-fc14-4be4-ac3a-1d551738d18a
OUTLOOK_CLIENT_SECRET=8808Q~K68ndQS6NNeejDByFvNGAUrwCWcp96ydfl

# ── Redirect Configuration (Port 8080) ───────────────────────
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
OUTLOOK_REDIRECT_URI=http://localhost:8080/api/auth/outlook/callback
FRONTEND_URL=http://localhost:8080
# Optional OAuth-backed AI gateway (CLIProxyAPI)
CLIPROXY_ENABLED=false
CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_URL=http://127.0.0.1:8317
CLIPROXY_MANAGEMENT_KEY=
CLIPROXY_MODEL=gpt-5.4-mini
CLIPROXY_FALLBACK_PROVIDER=openrouter
CLIPROXY_TIMEOUT_MS=60000
CLIPROXY_CIRCUIT_FAILURES=3
CLIPROXY_CIRCUIT_COOLDOWN_MS=60000
